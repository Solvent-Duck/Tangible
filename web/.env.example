# Where the FastAPI workbench listens (proxied at /api/*).
TANGIBLE_API_URL=http://127.0.0.1:8000

# "dev" uses the workbench's dev headers (TANGIBLE_DEV_AUTH=1 on the API) and a user picker.
# "clerk" uses Clerk (TANGIBLE_AUTH_MODE=clerk on the API).
NEXT_PUBLIC_AUTH_MODE=dev

# Clerk (only with NEXT_PUBLIC_AUTH_MODE=clerk). Without keys, Clerk runs in keyless dev mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
