{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "workbench",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_DEV_AUTH=1",
        "TANGIBLE_EVIDENCE_DIR=.evidence",
        "uv",
        "run",
        "tangible-workbench"
      ],
      "port": 8000
    },
    {
      "name": "workbench-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_DEV_AUTH=1",
        "TANGIBLE_EVIDENCE_DIR=.evidence",
        "TANGIBLE_MODEL_BACKEND=bedrock",
        "TANGIBLE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0",
        "TANGIBLE_BEDROCK_REGION=us-east-2",
        "TANGIBLE_PRICE_IN_PER_MTOK=3.30",
        "TANGIBLE_PRICE_OUT_PER_MTOK=16.50",
        "AWS_PROFILE=tangible",
        "TANGIBLE_WEB_PROVIDER=fixtures",
        "TANGIBLE_PORT=8001",
        "uv",
        "run",
        "--with",
        "botocore[crt]",
        "tangible-workbench"
      ],
      "port": 8001
    },
    {
      "name": "workbench-design",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_DEV_AUTH=1",
        "TANGIBLE_EVIDENCE_DIR=.evidence",
        "TANGIBLE_WEB_PROVIDER=fixtures",
        "TANGIBLE_PORT=8002",
        "uv",
        "run",
        "tangible-workbench"
      ],
      "port": 8002
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_DEV_AUTH=1",
        "TANGIBLE_EVIDENCE_DIR=.evidence",
        "TANGIBLE_WEB_PROVIDER=fixtures",
        "TANGIBLE_PUBLIC_URL=http://localhost:3000",
        "TANGIBLE_PORT=8010",
        "uv",
        "run",
        "tangible-workbench"
      ],
      "port": 8010
    },
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_API_URL=http://127.0.0.1:8010",
        "NEXT_PUBLIC_AUTH_MODE=dev",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "api-clerk",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_AUTH_MODE=clerk",
        "TANGIBLE_CLERK_ISSUER=https://neat-krill-697.clerk.accounts.dev",
        "TANGIBLE_CLERK_AUTHORIZED_PARTIES=http://localhost:3000",
        "TANGIBLE_EVIDENCE_DIR=.evidence",
        "TANGIBLE_WEB_PROVIDER=fixtures",
        "TANGIBLE_PUBLIC_URL=http://localhost:3000",
        "TANGIBLE_PORT=8011",
        "uv",
        "run",
        "tangible-workbench"
      ],
      "port": 8011
    },
    {
      "name": "web-clerk",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_API_URL=http://127.0.0.1:8011",
        "NEXT_PUBLIC_AUTH_MODE=clerk",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "api-strands",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TANGIBLE_DEV_AUTH=1",
        "TANGIBLE_EVIDENCE_DIR=.evidence",
        "TANGIBLE_AGENT_ENGINE=strands",
        "TANGIBLE_SIGNAL_PROVIDER=fixtures",
        "TANGIBLE_WEB_PROVIDER=fixtures",
        "TANGIBLE_MODEL_BACKEND=bedrock",
        "TANGIBLE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0",
        "TANGIBLE_BEDROCK_REGION=us-east-2",
        "TANGIBLE_PRICE_IN_PER_MTOK=3.30",
        "TANGIBLE_PRICE_OUT_PER_MTOK=16.50",
        "AWS_PROFILE=tangible",
        "TANGIBLE_PUBLIC_URL=http://localhost:3000",
        "TANGIBLE_PORT=8004",
        "uv",
        "run",
        "--with",
        "botocore[crt]",
        "tangible-workbench"
      ],
      "port": 8004
    }
  ]
}
